<%
  const efetivo = (typeof efetivoPorCargo !== 'undefined' && efetivoPorCargo) ? efetivoPorCargo : { IPC: 0, EPC: 0, DPC: 0 };
  const ano = (typeof anoEfetivo !== 'undefined') ? anoEfetivo : new Date().getFullYear();
  const cargosLimite = [
    { key: 'ipc', label: 'IPC' },
    { key: 'epc', label: 'EPC' },
    { key: 'dpc', label: 'DPC' }
  ];
  const piso = (percent, total) => {
    const pct = Number(percent);
    const amount = Number(total);
    if (!Number.isFinite(pct) || !Number.isFinite(amount) || pct <= 0 || amount <= 0) return 0;
    return Math.floor((pct * amount) / 100);
  };
  const numeroOu = (key, fallback) => {
    const current = settings && settings[key];
    return current === undefined || current === null || current === '' ? fallback : current;
  };
%>
<style>
  #configLimitsModal .regra-limite { min-width: 18rem; white-space: normal; }
  #configLimitsModal th, #configLimitsModal td { vertical-align: top; }
</style>
<div class="modal fade" id="configLimitsModal" tabindex="-1" aria-labelledby="configLimitsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-primary">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="configLimitsModalLabel">
          <i class="bi bi-sliders2 me-2"></i>Configuração de Limites
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <form action="/users/update-limits" method="POST">
          <p class="small text-muted mb-3">
            Os limites valem por cargo. IPC-P conta no efetivo de IPC, EPC-P no de EPC e DPC-P no de DPC.
            O efetivo considerado nesta tela é o de <%= ano %>.
          </p>

          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead class="table-light">
                <tr>
                  <th class="regra-limite">Regra</th>
                  <% cargosLimite.forEach((cargo) => { %>
                    <th class="text-center"><%= cargo.label %><br><span class="fw-normal text-muted">efetivo <%= efetivo[cargo.label] || 0 %></span></th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="regra-limite">
                    <label class="form-label mb-1">Inícios do 1º período no mesmo mês</label>
                    <div class="small text-muted">Percentual do efetivo. O resultado é arredondado para baixo. Vale para o 1º período e para o período único de 30 dias.</div>
                  </td>
                  <% cargosLimite.forEach((cargo) => { %>
                    <td style="min-width: 9rem;">
                      <div class="input-group input-group-sm">
                        <input type="number" class="form-control" name="pct_primeiro_<%= cargo.key %>" id="pct_primeiro_<%= cargo.key %>" min="0" max="100" required value="<%= numeroOu('pct_primeiro_' + cargo.key, 15) %>" data-efetivo="<%= efetivo[cargo.label] || 0 %>">
                        <span class="input-group-text">%</span>
                      </div>
                      <div class="small text-muted mt-1">Permite <strong id="preview_primeiro_<%= cargo.key %>"><%= piso(numeroOu('pct_primeiro_' + cargo.key, 15), efetivo[cargo.label] || 0) %></strong> por mês</div>
                    </td>
                  <% }); %>
                </tr>
                <tr>
                  <td class="regra-limite">
                    <label class="form-label mb-1">Servidores em 2º ou 3º período ao mesmo tempo</label>
                    <div class="small text-muted">Número livre. Em branco, usa 20% do efetivo, arredondado para baixo. A sugestão é não passar desse valor.</div>
                  </td>
                  <% cargosLimite.forEach((cargo) => { %>
                    <td>
                      <% const sugestao = piso(20, efetivo[cargo.label] || 0); %>
                      <input type="number" class="form-control form-control-sm" name="max_seguintes_<%= cargo.key %>" id="max_seguintes_<%= cargo.key %>" min="0" value="<%= settings && settings['max_seguintes_' + cargo.key] !== null && settings['max_seguintes_' + cargo.key] !== undefined ? settings['max_seguintes_' + cargo.key] : '' %>" placeholder="auto">
                      <div class="small text-muted mt-1">Sugestão de 20%: <%= sugestao %></div>
                    </td>
                  <% }); %>
                </tr>
                <tr>
                  <td class="regra-limite">
                    <label class="form-label mb-1">Choque ignorado</label>
                    <div class="small text-muted">Dias úteis de sobreposição que não impedem a marcação do 2º ou 3º período. Sábado e domingo não entram na conta.</div>
                  </td>
                  <% cargosLimite.forEach((cargo) => { %>
                    <td>
                      <div class="input-group input-group-sm">
                        <input type="number" class="form-control" name="tolerancia_dias_<%= cargo.key %>" id="tolerancia_dias_<%= cargo.key %>" min="0" max="366" required value="<%= numeroOu('tolerancia_dias_' + cargo.key, 0) %>">
                        <span class="input-group-text">dias</span>
                      </div>
                    </td>
                  <% }); %>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="modal-footer px-0">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2-circle"></i> Salvar Limites
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    document.querySelectorAll('[data-efetivo]').forEach((input) => {
      const atualizar = () => {
        const efetivoCargo = Number(input.dataset.efetivo) || 0;
        const percentual = parseInt(input.value, 10);
        const limite = Number.isFinite(percentual) && percentual > 0 ? Math.floor((percentual * efetivoCargo) / 100) : 0;
        const destino = document.getElementById(input.id.replace('pct_primeiro_', 'preview_primeiro_'));
        if (destino) destino.textContent = String(limite);
      };
      input.addEventListener('input', atualizar);
    });
  })();
</script>
