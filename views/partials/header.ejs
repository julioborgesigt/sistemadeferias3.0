<%
  const navbarVisible = typeof showNavbar === 'undefined' || showNavbar === true;
  const pageTitle = typeof title !== 'undefined' ? title : 'Sistema de Férias';
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <link href="/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/styles.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" rel="stylesheet">
  <style>
    .skip-link { position: absolute; left: 1rem; top: -3rem; z-index: 2000; }
    .skip-link:focus { top: 0.75rem; }
    @media (min-width: 992px) {
      #appSidebar.offcanvas {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 1020;
        display: flex !important;
        visibility: visible !important;
        width: 17rem;
        max-width: 17rem;
        transform: none !important;
      }
      body:not(.is-guest) .app-main { margin-left: 17rem; }
    }
  </style>
</head>
<body class="app-body<%= navbarVisible ? '' : ' is-guest' %>">
  <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>

  <div class="app-shell">
    <% if (navbarVisible) { %>
      <%- include('sidebar') %>
    <% } %>

    <div class="app-main">
      <% if (navbarVisible) { %>
        <header class="app-topbar d-lg-none">
          <button class="app-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar">
            <i class="bi bi-list" aria-hidden="true"></i>
            <span class="visually-hidden">Abrir menu</span>
          </button>
          <span class="app-topbar-title"><%= pageTitle %></span>
        </header>
      <% } %>

      <main class="app-content" id="conteudo-principal">
